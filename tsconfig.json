{
  "compilerOptions": {
    /* ── Language & runtime ───────────────────────────────────────────────
     * Node executes our .ts files directly via native type stripping.
     * That constrains us to *erasable* syntax only: no enums, no
     * namespaces, no parameter properties. `erasableSyntaxOnly` makes the
     * compiler enforce exactly that, so `node src/cli.ts` always works.
     */
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,

    /* ── Emit ─────────────────────────────────────────────────────────────
     * tsc is used purely as a type checker (`--noEmit`). There is no build
     * step, no dist/, no bundler. Source is the artifact.
     */
    "noEmit": true,

    /* ── Strictness ───────────────────────────────────────────────────────
     * A cognitive kernel deals in uncertainty; the type system should not
     * be one of the uncertain parts.
     */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts"],
  "exclude": ["node_modules"]
}
